      <aliases enabled='yes' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_1235062618644480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Total Revenue Before Discount' datatype='real' name='[Calculation_1235062621114369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]*[Order Quantity]' />
      </column>
      <column caption='Aggregate Profit Margin' datatype='real' name='[Calculation_1235062624362498]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_1235062625173507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Province]: SUM([Sales])}' />
      </column>
      <column caption='Include Sales Per Customer' datatype='real' name='[Calculation_1235062626701316]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Order ID] : SUM([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude Category Sales ' datatype='real' name='[Calculation_1235062628274181]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Product Sub-Category]: SUM([Sales])}' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_1235062629736455]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 1235062629314566] THEN &quot;Target Achieved&quot;&#13;&#10;ELSE &quot;Below Target&quot;&#13;&#10;END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_1235062631964680]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount], 0)' />
      </column>
      <column caption='Stadardized Provison Type ' datatype='string' name='[Calculation_1235062632525833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([Province])' />
      </column>
