      <aliases enabled='yes' />
      <column caption='Physics_Clean' datatype='real' name='[Calculation_0276842464653312]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_Clean' datatype='real' name='[Calculation_0276842464735233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Math_Clean' datatype='integer' name='[Calculation_0276842464833538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean' datatype='integer' name='[Calculation_0276842464935939]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry], 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_0276842466680836]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_0276842476769285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0276842464833538] + [Calculation_0276842464653312] + [Calculation_0276842464935939] + [Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' name='[Calculation_0276842477359110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0276842476769285] / 400.0' />
      </column>
      <column caption='Performance_Band' datatype='string' name='[Calculation_0276842477821959]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0276842477359110] &gt;= 0.85 THEN &quot;Distinction&quot;&#13;&#10;ELSEIF [Calculation_0276842477359110] &gt;= 0.75 THEN &quot;First Class&quot;&#13;&#10;ELSEIF [Calculation_0276842477359110] &gt;= 0.60 THEN &quot;Second Class&quot;&#13;&#10;ELSE &quot;Needs Academic Support&quot;&#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_0276842478407688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0276842464735233] &gt;= 75 THEN &quot;Eligible (Good Standing)&quot;&#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' name='[Calculation_0276842482819081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_0276842477359110]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' name='[Calculation_0276842484072458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_0276842477359110]) }' />
      </column>
      <column caption='Benchmark_Status  ' datatype='string' name='[Calculation_0276842484613131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0276842482819081] &gt;= 0 THEN &quot;Above Department Benchmark&quot;&#13;&#10;ELSE &quot;Below Department Benchmark&quot;&#13;&#10;END' />
      </column>
      <column caption='Full_Name_Clean' datatype='string' name='[Calculation_0276842488356876]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(TRIM([Full_Name]), 1)) +&#13;&#10;LOWER(MID(TRIM([Full_Name]), 2, FIND(TRIM([Full_Name]), &quot; &quot;) - 1)) +&#13;&#10;&quot; &quot; +&#13;&#10;UPPER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 1, 1)) +&#13;&#10;LOWER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 2, LEN(TRIM([Full_Name]))))' />
      </column>
      <column caption='First_Name' datatype='string' name='[Calculation_0276842488655885]' role='dimension' type='nominal'>
