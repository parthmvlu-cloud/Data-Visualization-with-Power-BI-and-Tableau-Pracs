      <aliases enabled='yes' />
      <column caption='Cumulative Votes (RUNNING_SUM)' datatype='integer' name='[Calculation_0526702575357953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Restraunt Rank' datatype='integer' name='[Calculation_0526702579064834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='City Window Avg Cost' datatype='real' name='[Calculation_0526702581391363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference From Window Sum' datatype='real' name='[Calculation_0526702586056708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Dynamic Title ' datatype='string' name='[Calculation_0526702589767687]' role='dimension' type='nominal'>
